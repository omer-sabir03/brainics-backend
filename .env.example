# Copy this file to ".env" (same folder as pom.xml) and fill in your NEW Neon details.
# ".env" is git-ignored. Never commit it and never paste it into chat.

# From the Neon dashboard -> Connect. Use the DIRECT host (no "-pooler" in the name).
# Format: jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://ep-your-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=put-your-new-password-here

# Optional
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000
